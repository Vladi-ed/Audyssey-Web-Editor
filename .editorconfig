# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.html]
max_line_length = off
ij_typescript_use_double_quotes = true
# The save watcher enforces the attribute-count threshold; keep its line breaks.
ij_html_attribute_wrap = off
ij_html_keep_line_breaks = true
ij_html_align_attributes = false
ij_html_new_line_before_first_attribute = when_multiline
ij_html_new_line_before_tag_end = when_multiline
ij_html_continuation_indent_size = 4

[*.ts]
ij_typescript_force_quote_style = true
ij_typescript_spaces_within_imports = true
ij_typescript_use_double_quotes = false
quote_type = single

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.json]
indent_size = 2
